# Copy this file to .env and fill local-only values.
# Keep .env out of git.

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=catams
MYSQL_USER=catams
MYSQL_PASSWORD=change-me

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me

SPRING_RABBITMQ_HOST=catams-rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=admin
SPRING_RABBITMQ_PASSWORD=change-me

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/catams?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
SPRING_DATASOURCE_USERNAME=catams
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=prod

MAIL_USERNAME=your-mail@example.com
MAIL_PASSWORD=your-smtp-authorization-code